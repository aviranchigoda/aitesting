# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Security Configuration (REPLACE WITH STRONG VALUES IN PRODUCTION)
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET_256_BITS_OR_MORE
ENCRYPTION_KEY=REPLACE_WITH_STRONG_ENCRYPTION_KEY_256_BITS
API_KEY_SALT=REPLACE_WITH_STRONG_API_KEY_SALT_128_BITS

# Database Configuration (if using external DB)
DATABASE_URL=your-production-database-url

# AI Service Configuration
AI_ENDPOINT=your-production-ai-service-endpoint
AI_API_KEY=your-production-ai-service-api-key

# Rate Limiting (Production values)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS (Production domains)
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true